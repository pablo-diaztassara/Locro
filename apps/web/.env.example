# URL pública de la web (usada para SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://locro.com.ar

# Link directo de WhatsApp (ej. https://wa.me/54911XXXXXXXX)
# Si se deja vacío, usa un enlace wa.me genérico con mensaje precargado.
NEXT_PUBLIC_WHATSAPP_URL=

# Webhook de n8n para captura de leads (Track 4)
# Si se deja vacío en desarrollo local, el endpoint registra el lead en consola sin fallar.
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
